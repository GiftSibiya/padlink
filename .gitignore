# Cargo workspace (root target dir; crate sources stay tracked)
/target/
**/*.rs.bk

# Python reference core (tests and fixture generators)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
build/
dist/

# makepkg (PKGBUILD). Anchored so crates/*/src is not ignored.
/pkg/
/src/
/*.pkg.tar*
/*.src.tar*

# Local MCP config (bearer token)
.mcp.json
.cursor/mcp.json
